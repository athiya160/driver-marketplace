{
  "expo": {
    "name": "Personal Driver Marketplace",
    "slug": "personal-driver-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1E36"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.personaldriver.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Personal Driver Marketplace requires your location to find nearby verified drivers for your vehicle.",
        "NSLocationAlwaysUsageDescription": "Personal Driver Marketplace needs background location during active trips to track driver arrival and route.",
        "NSCameraUsageDescription": "Personal Driver Marketplace uses camera access to scan booking QR codes and upload driver documents."
      }
    },
    "android": {
      "package": "in.personaldriver.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1E36"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "personal-driver-marketplace-india"
      },
      "apiUrl": "http://localhost:5000/api",
      "currency": "INR",
      "country": "IN",
      "supportPhone": "+91 800 123 4567"
    }
  }
}
