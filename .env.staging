# ==============================================================================
# PERSONAL DRIVER MARKETPLACE - STAGING ENVIRONMENT CONFIGURATION (.env.staging)
# "Your Car. Your Journey. Your Driver."
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=staging
CORS_ORIGIN=https://salman-driver-staging.onrender.com,http://localhost:5000,http://localhost:5173

# Administrative Security & Secrets
ADMIN_PASSWORD=SalmanStagingSecOps#2026!
JWT_SECRET=driver_marketplace_staging_jwt_secret_key_32_chars_minimum
REFRESH_TOKEN_SECRET=driver_marketplace_staging_refresh_secret_key_32_chars
OTP_SALT=staging_salted_otp_crypto_salt_2026

# Distributed State & Mutex (Local container or Redis Cloud staging instance)
REDIS_URL=redis://127.0.0.1:6379

# Hosted Supabase PostgreSQL & Auth (Backend-Only Service Key)
# CRITICAL: Never prefix with VITE_ to prevent client bundle leakage
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-backend-only

# Razorpay Indian Payment Gateway (STRICTLY SANDBOX TEST MODE)
RAZORPAY_KEY_ID=rzp_test_StagingKeyPlaceholder
RAZORPAY_KEY_SECRET=rzp_secret_StagingSecretPlaceholder
RAZORPAY_WEBHOOK_SECRET=rzp_wh_secret_staging_placeholder
RAZORPAY_ROUTE_ENABLED=false # Real bank payouts are disabled in staging

# Geolocation & Mapping Providers
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Transactional Communications (MSG91 SMS Simulator until TRAI DLT approved)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=DRVSAT
MSG91_DLT_ENTITY_ID=

# Tax & Statutory Configurations (Configurable per CA advice)
STATUTORY_GST_PERCENT=5
STATUTORY_PLATFORM_FEE=49
