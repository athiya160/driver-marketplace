# Razorpay Indian Payment Gateway (Test / Sandbox Credentials)
RAZORPAY_KEY_ID=rzp_test_SarathiSandboxKey123
RAZORPAY_KEY_SECRET=rzp_secret_SandboxSecret456

# Google Maps Platform API Key (Geocoding & Autocomplete)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Expo Mobile Bundler
EXPO_PORT=8081
METRO_PORT=8081
