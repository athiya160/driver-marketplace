# ==============================================================================
# PERSONAL DRIVER MARKETPLACE ("Your Car. Your Journey. Your Driver.")
# Production Deployment & Security Environment Configuration Template
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production # 'development' | 'staging' | 'production' | 'test'
CORS_ORIGIN=https://salman-driver.yourdomain.com,https://staging.yourdomain.com

# Administrative Operations Security
# In production, default PINs and hardcoded passwords are disabled. You must provide a strong secret:
ADMIN_PASSWORD=your_strong_production_admin_password_min_16_chars

# Authentication & Cryptographic Secrets (Minimum 32 random characters each)
JWT_SECRET=your_production_jwt_signing_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_production_refresh_token_secret_here_min_32_chars
OTP_SALT=your_cryptographic_otp_salt_here

# Distributed State & Locks (Managed Redis Cluster, e.g. Upstash, Redis Cloud)
REDIS_URL=rediss://default:your_redis_password@your-redis-endpoint:6379

# Hosted Supabase PostgreSQL & Auth
# CRITICAL SECURITY RULE: SUPABASE_SERVICE_ROLE_KEY must remain BACKEND ONLY.
# NEVER prefix with VITE_ and NEVER commit to client-side bundles.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# Razorpay Indian Payment Gateway
# STRICT NOTICE: Keep in TEST MODE (rzp_test_*) until merchant onboarding & KYC complete.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=rzp_secret_YourSecretKeyHere
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ROUTE_ENABLED=false # Keep false until Route onboarding & linked accounts approved

# Geolocation & Maps Platform APIs
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token_here

# MSG91 Transactional SMS Gateway (TRAI DLT Approved Templates)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=DRVSAT
MSG91_DLT_ENTITY_ID=1101XXXXXXXXXX
MSG91_DLT_TE_ID_OTP=1107160000000000000

# Statutory & Tax Configuration (Must be reviewed by CA prior to commercial launch)
STATUTORY_GST_PERCENT=5
STATUTORY_PLATFORM_FEE=49

# Expo Mobile Bundler
EXPO_PORT=8081
METRO_PORT=8081
