# ==============================================================================
# PERSONAL DRIVER MARKETPLACE ("Your Car. Your Journey. Your Driver.")
# Production Deployment & Security Environment Configuration Template
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Authentication & Cryptographic Secrets
JWT_SECRET=your_production_jwt_signing_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_production_refresh_token_secret_here_min_32_chars
OTP_SALT=your_cryptographic_otp_salt_here

# Supabase PostgreSQL Database & Auth
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only

# Razorpay Indian Payment Gateway (Keep TEST MODE for pre-launch audits)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=rzp_secret_YourSecretKeyHere
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_ROUTE_ENABLED=false # Keep false until Route onboarding approved

# Geolocation & Maps Platform APIs
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token_here

# MSG91 Transactional SMS Gateway (DLT Approved Templates)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=DRVSAT
MSG91_DLT_TE_ID_OTP=1107160000000000000

# Expo Mobile Bundler
EXPO_PORT=8081
METRO_PORT=8081
